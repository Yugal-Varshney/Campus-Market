# Copy to e2e/.env (never commit it) and fill in. Use a STAGING Supabase project and a Vercel PREVIEW URL, not production:
# the tests post, edit, report, hide and delete listings.
E2E_BASE_URL=https://your-preview-url.vercel.app

# Four pre-created, already-confirmed accounts on the staging project.
E2E_STUDENT_A_EMAIL=
E2E_STUDENT_A_PASSWORD=
E2E_STUDENT_B_EMAIL=
E2E_STUDENT_B_PASSWORD=
# A is the seller, B the buyer/reporter. MOD must have role 'moderator' and ADMIN role 'admin' (see docs/PHASE7_RUNBOOK.md).
E2E_MODERATOR_EMAIL=
E2E_MODERATOR_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
